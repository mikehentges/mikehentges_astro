    name: "Mike Hentges",
    url: "https://hentges.ai",
    jobTitle: "AI Practitioner & Technology Advisor",
    description: "20+ years as CTO of a Fortune 500 systems integrator, 3 years as IT Director at a mid-sized manufacturer, and deep applied AI expertise.",
    sameAs: ["https://www.linkedin.com/in/mikehentges/"],
