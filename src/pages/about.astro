<BaseLayout
  title="About | Hentges.AI"
  description="Mike Hentges: 20+ years as CTO at a Fortune 500 systems integrator, 3 years as IT Director in manufacturing, and deep applied AI expertise. Building the right thing, the right way."
  jsonLd={{
    "@context": "https://schema.org",
