---
interface Props {
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

function isActive(href: string): boolean {
  return currentPath === href || currentPath === `${href}/`;
}
---

<nav
  class:list={[
    'sticky top-0 z-50 w-full transition-[background-color,backdrop-filter] duration-200 ease-in-out',
    transparent ? 'bg-transparent' : 'bg-surface/95 backdrop-blur-md',
  ]}
  data-transparent={transparent || undefined}
  aria-label="Main navigation"
>
  <div class="mx-auto flex max-w-[1200px] items-center justify-between px-6 py-4 md:px-8">
    <a href="/" class="font-display text-lg font-semibold text-text-primary no-underline">
      Hentges<span class="text-accent">.ai</span>
    </a>

    <ul class="flex list-none gap-6 p-0" role="list">
      {navLinks.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class:list={[
              'text-sm font-medium no-underline transition-colors duration-200 ease-in-out',
              isActive(href)
                ? 'text-accent'
                : 'text-text-secondary hover:text-text-primary',
            ]}
            aria-current={isActive(href) ? 'page' : undefined}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<noscript>
  <style>
    nav[data-transparent] {
      background-color: var(--color-surface);
      backdrop-filter: blur(12px);
    }
  </style>
</noscript>

<script>
  const nav = document.querySelector<HTMLElement>('nav[data-transparent]');
  if (nav) {
    const SCROLL_THRESHOLD = 100;

    function updateNav() {
      if (window.scrollY > SCROLL_THRESHOLD) {
        nav!.classList.remove('bg-transparent');
        nav!.classList.add('bg-surface/95', 'backdrop-blur-md');
      } else {
        nav!.classList.add('bg-transparent');
        nav!.classList.remove('bg-surface/95', 'backdrop-blur-md');
      }
    }

    window.addEventListener('scroll', updateNav, { passive: true });
    updateNav();
  }
</script>
