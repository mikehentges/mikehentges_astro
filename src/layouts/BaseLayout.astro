---
import '../styles/global.css';
import StickyNav from '../components/StickyNav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  transparent?: boolean;
}

const { title = 'Hentges.AI', transparent = false } = Astro.props;
---

<!doctype html>
<html lang="en" class="no-js">
<script is:inline>document.documentElement.classList.remove('no-js');</script>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col bg-background text-text-primary">
    <a href="#content" class="skip-link">Skip to content</a>
    <StickyNav transparent={transparent} />
    <div class="mx-auto max-w-[1200px] flex-1 px-6 md:px-8">
      <main id="content" tabindex="-1">
        <slot />
      </main>
    </div>
    <Footer />
  </body>
</html>
